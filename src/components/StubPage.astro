---
// Shared shell for pages that exist in the navigation and information
// architecture but whose real content arrives in a later phase (Music =
// Phase 2, Videos/Journal = Phase 3, Links = whenever the artist has a
// list worth linking to). Keeps every nav item clickable and 404-free
// from day one, without faking content that doesn't exist yet.

import { getLangFromUrl, useTranslations } from '../lib/i18n';

interface Props {
  heading: string;
}

const { heading } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
---

<section class="container-page stub">
  <p class="kicker">{t('stub.badge')}</p>
  <h1>{heading}</h1>
  <p class="stub-body">{t('stub.body')}</p>
  <a href={homeHref} class="stub-back">← {t('stub.back')}</a>
</section>

<style>
  .stub {
    padding-block: 5rem;
    max-width: 40rem;
  }

  .stub h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-block: 0.6rem 1rem;
  }

  .stub-body {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .stub-back {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .stub-back:hover {
    text-decoration: underline;
  }
</style>
