---
// Shared Videos gallery — rendered by src/pages/videos.astro (pt) and
// src/pages/en/videos.astro (en). Grouped by year, newest first — same
// pattern as the Music page's timeline.

import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from './EmptyState.astro';
import VideoCard from './VideoCard.astro';
import { getLangFromUrl, useTranslations } from '../lib/i18n';
import { getSortedVideos, groupVideosByYear } from '../lib/videos';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const videos = await getSortedVideos();
const yearGroups = groupVideosByYear(videos);
---

<BaseLayout title={t('videos.title')} description={t('site.description')}>
  <section class="container-page videos-hero">
    <p class="kicker">{t('nav.videos')}</p>
    <h1>{t('videos.title')}</h1>
  </section>

  <section class="container-page videos-grid-section">
    {
      yearGroups.length === 0 ? (
        <EmptyState message={t('videos.empty')} />
      ) : (
        yearGroups.map((group) => (
          <div class="year-group">
            <h2 class="kicker year-label">{group.year}</h2>
            <div class="video-grid">
              {group.videos.map((video) => (
                <VideoCard video={video} lang={lang} />
              ))}
            </div>
          </div>
        ))
      )
    }
  </section>
</BaseLayout>

<style>
  .videos-hero {
    padding-block: 3rem 2rem;
  }

  .videos-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-block: 0.4rem 0;
  }

  .videos-grid-section {
    padding-block: 1rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .year-label {
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }

  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .video-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
