---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../lib/i18n';
import { withBase } from '../lib/paths';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = withBase(lang === 'en' ? '/en/' : '/');
---

<BaseLayout title="404">
  <section class="container-page not-found">
    <p class="kicker">404</p>
    <h1>{t('404.title')}</h1>
    <p class="body-text">{t('404.body')}</p>
    <a href={homeHref} class="back-link">← {t('stub.back')}</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 6rem;
    max-width: 34rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-block: 0.6rem 1rem;
  }

  .body-text {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .back-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
