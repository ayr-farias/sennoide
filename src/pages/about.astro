---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = [
  {
    heading: 'O projeto',
    body: 'Sennóide é um projeto musical solo, independente desde 2021, com sede no Brasil. Cada lançamento — álbum, EP ou single — é escrito, gravado e publicado sem selo, sem distribuidora e, propositalmente, sem plataformas de streaming pelo meio.',
  },
  {
    heading: 'A música',
    body: 'O trabalho transita entre o experimental e o alternativo, incluindo canções e vídeos musicais feitos de forma caseira — alguns deles com banda ao vivo. Este site é o arquivo completo: cada fase, cada formato, em um só lugar.',
  },
  {
    heading: 'Produção DIY',
    body: 'Gravação, mixagem, vídeo e distribuição — tudo feito por conta própria. Essa abordagem exige mais tempo, mas mantém o controle criativo inteiro nas mãos do artista, do primeiro rascunho até a publicação.',
  },
  {
    heading: 'Experimentos com IA',
    body: 'Uma parte recente do trabalho revisita composições antigas com ferramentas de IA, como o Suno, para explorar novos arranjos e orquestrações. As composições originais continuam inteiramente autorais; essas versões exploram possibilidades sonoras alternativas — não as substituem.',
  },
  {
    heading: 'Trabalho atual',
    body: 'Novos rearranjos e lançamentos estão em andamento. O Diário reúne atualizações curtas sobre o que está sendo feito, à medida que acontece.',
  },
];
---

<BaseLayout title={t('about.title')} description={t('about.intro')}>
  <section class="container-page about-page">
    <p class="kicker">{t('section.about.label')}</p>
    <h1>Sobre</h1>
    <p class="intro">{t('about.intro')}</p>

    <div class="sections">
      {
        sections.map((section) => (
          <article class="about-section">
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: 4rem 5rem;
    max-width: 42rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-block: 0.5rem 1.25rem;
  }

  .intro {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 3rem;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .about-section h2 {
    font-size: 1.15rem;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .about-section p {
    color: var(--color-text);
    line-height: 1.7;
  }
</style>
