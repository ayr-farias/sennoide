---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

Here's the translation of that array, keeping the same structure:

const sections = [
  {
    heading: 'The project',
    body: 'Sennóide is a solo music project, independent since 2021, based in Recife, Brazil. Every release — album, EP, or single — is written, recorded, and published without a label, without a distributor, and, deliberately, without the intermediary of streaming platforms.',
  },
  {
    heading: 'The music',
    body: 'The work moves between the experimental and the alternative, including songs both with lyrics and instrumental, alongside homemade music videos — some featuring a live band in studio. This site is the complete archive: every phase, every format, in one place.',
  },
  {
    heading: 'DIY production',
    body: 'Recording, mixing, video, and distribution — all done independently. This approach demands more time, with the effort concentrated in a single person, but it keeps full creative control in the artist\'s hands, from the first draft through to publication.',
  },
  {
    heading: 'AI experiments',
    body: 'A recent part of the work revisits older compositions using AI tools, such as Suno, to explore new arrangements and orchestrations. The original compositions remain entirely authorial; these versions explore alternative sonic possibilities — they do not replace them.',
  },
  {
    heading: 'Current work',
    body: 'New rearrangements and releases are in progress. The Journal gathers short updates on what\'s being worked on, as it happens.',
  },
];
---

<BaseLayout title={t('about.title')} description={t('about.intro')}>
  <section class="container-page about-page">
    <p class="kicker">{t('section.about.label')}</p>
    <h1>About</h1>
    <p class="intro">{t('about.intro')}</p>

    <div class="sections">
      {
        sections.map((section) => (
          <article class="about-section">
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: 4rem 5rem;
    max-width: 42rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-block: 0.5rem 1.25rem;
  }

  .intro {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 3rem;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .about-section h2 {
    font-size: 1.15rem;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .about-section p {
    color: var(--color-text);
    line-height: 1.7;
  }
</style>
