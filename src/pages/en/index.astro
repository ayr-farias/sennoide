---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SineDivider from '../../components/SineDivider.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="Sennóide">
  <section class="hero container-page">
    <p class="kicker">{t('home.kicker')}</p>
    <h1 class="hero-title">SENNÓIDE</h1>
    <p class="hero-lead">{t('home.lead')}</p>
    <a href="/en/music" class="hero-cta">{t('home.cta')} <span aria-hidden="true">→</span></a>
    <p class="hero-note">{t('home.aiNote')}</p>
  </section>

  <SineDivider />

  <section class="container-page block">
    <h2 class="kicker block-label">{t('section.releases.label')}</h2>
    <EmptyState message={t('section.releases.empty')} />
  </section>

  <section class="container-page block">
    <h2 class="kicker block-label">{t('section.videos.label')}</h2>
    <EmptyState message={t('section.videos.empty')} />
  </section>

  <section class="container-page block">
    <h2 class="kicker block-label">{t('section.journal.label')}</h2>
    <EmptyState message={t('section.journal.empty')} />
  </section>

  <SineDivider />

  <section class="container-page block about-teaser">
    <h2 class="kicker block-label">{t('section.about.label')}</h2>
    <p class="about-teaser-text">
      Sennóide is an independent solo music project, active since 2021. Original songs, DIY
      videos, and AI-assisted arrangements — all self-hosted and self-distributed, with no
      streaming platform in between.
    </p>
    <a href="/en/about" class="about-teaser-link">{t('section.about.cta')} <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 4.5rem 3.5rem;
  }

  .hero-title {
    font-size: clamp(3rem, 12vw, 6.5rem);
    line-height: 0.95;
    margin-block: 0.5rem 1.25rem;
    letter-spacing: -0.01em;
  }

  .hero-lead {
    max-width: 34rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .hero-cta:hover {
    transform: translateX(2px);
  }

  .hero-note {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .block {
    padding-block: 3rem;
  }

  .block-label {
    margin-bottom: 1.25rem;
  }

  .about-teaser-text {
    max-width: 38rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .about-teaser-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .about-teaser-link:hover {
    text-decoration: underline;
  }
</style>
